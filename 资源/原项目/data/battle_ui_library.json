  "command_schema": {
    "required": {
      "id": "稳定的字符串标识",
      "label": "显示名称"
    },
    "optional": {
      "enabled": "bool，默认 true",
      "description": "按钮提示文字",
      "payload": "传给战斗系统的 Dictionary"
    }
  },
  "signals": {
    "category_opened": "category_id: StringName",
    "action_selected": "category_id: StringName, command_id: StringName, payload: Dictionary"
  },
  "documentation": "docs/回合制战斗UI框架说明.md",
  "scope": "仅制作框架。没有预置具体招式，没有伤害、魔法消耗、闪避结算、道具执行、投降或挂机战斗逻辑。"

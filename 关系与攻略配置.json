        }
      ],
      "retry": [
        {
          "actor": "gou_ga",
          "text": "你想替我抓着？松手，我自己来。"
        }
      ]
    },
    {
      "id": "gou_4",
      "title": "把真相留在灯下",
      "after": "tide_clear",
      "gain": 22,
      "flags": {
        "F_TRUTH": true
      },
      "shards": 3,
      "san": 60,
      "understand": 4,
      "dialogue": [
        {
          "actor": "gou_ga",
          "text": "你已经知道是谁把我推到门边了。可以只告诉我吗？我不想再被别人议论。"
        },
        {
          "actor": "zhao_mugei",
          "text": "证据要留下，才能有人负责。你的私人感受不会贴在公告栏上；发生过的伤害也不能删掉。"
        }
      ],
      "choices": [
        [
          "share",
          "把真相交给所有幸存者，而非私下藏起"
        ],
        [
          "excuse",
          "说她没有责任，只要跟着自己就好"
        ],
        [
          "cancel",
          "先不回答，改天再谈"
        ]
      ],
      "correct": "share",
      "resolution": [
        {
          "actor": "gou_ga",
          "text": "那就把证据分开。该公开的公开，我害怕的事……可以只说给你听吗？"
        }
      ],
      "retry": [
        {
          "actor": "gou_ga",
          "text": "分给谁得问他们。你一口答应，算谁答应的？"
        }
      ]
    },
    {
      "id": "gou_5",
      "title": "这一次自己松手",
      "after": "preparation",
      "gain": 26,
      "flags": {
        "F_TRUTH": true,
        "F_CIVILIAN_SAFE": true
      },
      "shards": 4,
      "san": 60,
      "understand": 4,
      "dialogue": [
        {
          "actor": "gou_ga",
          "text": "最后要是我控制不住，你还会叫我的名字吗？别答应得太快。"

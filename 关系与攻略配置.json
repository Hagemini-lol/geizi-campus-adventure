  "gou_stories": [
    {
      "id": "gou_1",
      "title": "裂缝里的回声",
      "after": "book_queen",
      "gain": 16,
      "flags": {},
      "shards": 0,
      "san": 0,
      "understand": 0,
      "dialogue": [
        {
          "actor": "gou_ga",
          "text": "门底有声音，喊得跟真的一样。有人说我能让它安静，所以我试了。后来每一次都要更多。"
        },
        {
          "actor": "zhao_mugei",
          "text": "听见声音不是你的错。把无辜的人拖进去是。我们先查清它怎么骗你。"
        }
      ],
      "choices": [
        [
          "promise",
          "听完她说话，不替她开脱"
        ],
        [
          "excuse",
          "说她没有责任，只要跟着自己就好"
        ],
        [
          "cancel",
          "先不回答，改天再谈"
        ]
      ],
      "correct": "promise",
      "resolution": [
        {
          "actor": "gou_ga",
          "text": "你没有说“我懂你”，也没立刻走。那……这一段我说完。"
        }
      ],
      "retry": [
        {
          "actor": "gou_ga",
          "text": "别替我找借口。我让别人难受了，这句还用你教？"
        }
      ]
    },
    {

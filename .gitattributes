* text=auto
*.gd text eol=lf
*.tscn text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
# Preserve the exact resource bytes recorded in 素材打包清单.json.
资源/** -text

# Keep upstream font license/provenance bytes, including their original line endings.
资源/字体/*.txt whitespace=-blank-at-eol,cr-at-eol
